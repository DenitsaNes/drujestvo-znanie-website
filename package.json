{
  "name": "minka",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-routes.mjs",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "seed:story": "tsx scripts/seed-minka-ist-neu.ts",
    "seed:story:api": "tsx scripts/seed-via-api.ts",
    "check:stories": "tsx scripts/check-stories.ts",
    "sr:dev": "tsx src/sr-module/server.ts",
    "sr:test": "jest src/sr-module/tests --config src/sr-module/jest.config.js",
    "sr:test:watch": "jest src/sr-module/tests --watch --config src/sr-module/jest.config.js",
    "sr:db:generate": "prisma generate --schema=src/sr-module/prisma/schema.prisma",
    "sr:db:push": "prisma db push --schema=src/sr-module/prisma/schema.prisma",
    "sr:db:migrate": "prisma migrate dev --schema=src/sr-module/prisma/schema.prisma",
    "sr:db:seed": "tsx src/sr-module/prisma/seed.ts",
    "test": "jest",
    "preview": "vite preview",
    "generate-og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@firebase/app": "^0.14.4",
    "@firebase/auth": "^1.11.0",
    "@firebase/firestore": "^4.9.2",
    "@firebase/storage": "^0.14.0",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@prisma/client": "^5.22.0",
    "express": "^4.21.2",
    "firebase": "^12.4.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.548.0",
    "next": "^16.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.4",
    "resend": "^6.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "baseline-browser-mapping": "^2.9.16",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "jest": "^29.7.0",
    "netlify-cli": "^27.12.1",
    "prisma": "^5.22.0",
    "sharp": "^0.35.5",
    "supertest": "^7.1.4",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite": "^8.3.4"
  }
}
